(defun test.expect (Label Actual Expected)
  (if (= Actual Expected) true (simple-error Label)))
(defun test.sum (N A)
  (if (= N 0) A (test.sum (- N 1) (+ A N))))
(defun test.even (N)
  (if (= N 0) true (test.odd (- N 1))))
(defun test.odd (N)
  (if (= N 0) false (test.even (- N 1))))
(defun test.add (X Y) (+ X Y))
(defun test.id (X) X)
(defun test.zero () 42)
(defun test.factory (X) (lambda Y (+ X Y)))
(defun test.capture (X) (lambda Y (let X (+ X Y) (lambda Z (+ X Z)))))
(defun test.helper (X) (+ X 1))
(defun test.caller (X) (test.helper X))
(defun test.tick (X)
  (do (set test.events (+ (* 10 (value test.events)) X)) X))
(defun test.stage (X)
  (do (test.tick 2) (lambda Y (+ X Y))))
(defun test.dynamic-order ()
  (do (set test.events 0)
      (do ((do (test.tick 1) (lambda X (test.stage X))) (test.tick 3) (test.tick 4))
          (value test.events))))
(defun test.call-order ()
  (do (set test.events 0)
      (do (test.add (test.tick 1) (test.tick 2)) (value test.events))))
(defun test.cons-order ()
  (do (set test.events 0)
      (do (cons (test.tick 1) (test.tick 2)) (value test.events))))
(defun test.failure-order ()
  (do (set test.events 0)
      (do (trap-error (test.add (simple-error "stop") (test.tick 1))
                      (lambda E caught))
          (value test.events))))
(defun test.trap-order ()
  (do (set test.events 0)
      (do (trap-error (test.tick 1) (do (test.tick 2) (lambda E caught)))
          (value test.events))))
(defun test.higher (F N A)
  (if (= N 0) A (test.higher F (- N 1) (F A))))
(defun test.build (N A)
  (if (= N 0) A (test.build (- N 1) (cons N A))))
(defun test.length (L A)
  (if (cons? L) (test.length (tl L) (+ A 1)) A))
(test.expect "arithmetic" (+ (* 3 4) (- 9 2)) 19)
(test.expect "negative literals" (+ -7 2) -5)
(test.expect "float" (+ 1.25 2.5) 3.75)
(test.expect "mixed numeric equality" (= 42 42.0) true)
(test.expect "intern true" (intern "true") true)
(test.expect "intern false" (intern "false") false)
(test.expect "intern decimal" (intern "42") 42)
(test.expect "lexical shadowing" (let X 7 (let X (+ X 1) X)) 8)
(test.expect "case-sensitive bindings" (let X 1 (let x 2 (cons X x))) (cons 1 2))
(test.expect "self recursion" (test.sum 1000 0) 500500)
(test.expect "mutual recursion" (test.even 1001) false)
(test.expect "zero arity" (test.zero) 42)
(test.expect "curried application" ((lambda X (lambda Y (test.add X Y))) 20 22) 42)
(test.expect "dynamic overapplication" (let F (lambda X (test.factory X)) (F 20 22)) 42)
(test.expect "closure capture" (((test.capture 10) 20) 12) 42)
(test.expect "function-valued operator" ((test.id (lambda X (+ X 1))) 41) 42)
(test.expect "higher order" (test.higher (lambda X (+ X 1)) 1000 0) 1000)
(test.expect "call evaluation order" (test.call-order) 12)
(test.expect "cons evaluation order" (test.cons-order) 12)
(test.expect "curried effect order" (test.dynamic-order) 1324)
(test.expect "error stops evaluation" (test.failure-order) 0)
(test.expect "handler evaluated before body" (test.trap-order) 21)
(test.expect "freeze capture" (let X 21 (thaw (freeze (+ X X)))) 42)
(test.expect "error" (trap-error (simple-error "boom") (lambda E (error-to-string E))) "boom")
(test.expect "nested error handler" (trap-error (trap-error (simple-error "inner") (lambda E (simple-error "outer"))) (lambda E (error-to-string E))) "outer")
(test.expect "primitive error" (trap-error (hd 12) (lambda E caught)) caught)
(test.expect "strict boolean" (trap-error (if 1 yes no) (lambda E caught)) caught)
(test.expect "and short circuit" (and false (simple-error "bad")) false)
(test.expect "or short circuit" (or true (simple-error "bad")) true)
(test.expect "and strict boolean" (trap-error (and true 1) (lambda E caught)) caught)
(test.expect "cond" (cond (false 1) (true 42)) 42)
(test.expect "list traversal" (test.length (test.build 1000 ()) 0) 1000)
(test.expect "structural equality" (= (test.build 1000 ()) (test.build 1000 ())) true)
true
