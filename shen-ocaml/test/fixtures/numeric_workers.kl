(defun numeric.sum (N A)
  (if (= N 0) A (numeric.sum (- N 1) (+ A N))))
(defun numeric.mul (N A X)
  (if (<= N 0) A (numeric.mul (- N 1) (* A X) X)))
(defun numeric.subtract (N A X)
  (if (> N 0) (numeric.subtract (- N 1) (- A X) X) A))
(defun numeric.let (N A)
  (let Next (- N 1)
    (if (and (>= N 1) (or (< N 10000) (= N 10000)))
        (numeric.let Next (+ A N)) A)))
(defun numeric.effect (N)
  (if (= N 0) 0 (do (set numeric.observed N) (numeric.effect (- N 1)))))
