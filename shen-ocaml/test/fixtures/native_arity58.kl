(defun arity58.f5 (A B C D E) (cons A (cons B (cons C (cons D (cons E ()))))))
(defun arity58.f6 (A B C D E F) (cons A (arity58.f5 B C D E F)))
(defun arity58.f7 (A B C D E F G) (cons A (arity58.f6 B C D E F G)))
(defun arity58.f8 (A B C D E F G H) (cons A (arity58.f7 B C D E F G H)))
(defun arity58.caller (A B C D E F G H) (arity58.f8 A B C D E F G H))
(defun arity58.tail5 (N A B C D) (if (= N 0) A (arity58.tail5 (- N 1) (+ A 1) B C D)))
(defun arity58.tail6 (N A B C D E) (if (= N 0) A (arity58.tail6 (- N 1) (+ A 1) B C D E)))
(defun arity58.tail7 (N A B C D E F) (if (= N 0) A (arity58.tail7 (- N 1) (+ A 1) B C D E F)))
(defun arity58.tail8 (N A B C D E F G) (if (= N 0) A (arity58.tail8 (- N 1) (+ A 1) B C D E F G)))
(defun arity58.mark (N) (do (set arity58.order (+ (* (value arity58.order) 10) N)) N))
(defun arity58.ordered () (arity58.f8 (arity58.mark 1) (arity58.mark 2) (arity58.mark 3) (arity58.mark 4) (arity58.mark 5) (arity58.mark 6) (arity58.mark 7) (arity58.mark 8)))
(defun arity58.and (A B) (and A B))
(defun arity58.or (A B) (or A B))
(defun arity58.pred (A B) (if (= A B) true false))
true
